; Independent Godot 4.6 project. Open this file in Godot and press F6/F5.
config_version=5

[application]
config/name="指板相對音程 · Fret Relations"
run/main_scene="res://src/trainer/trainer.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="在吉他指板上查和弦、音程與轉位，試聽不同弦組的按法，也能從目前的位置開始練習。"

[display]
window/size/viewport_width=1360
window/size/viewport_height=900
window/size/window_width_override=1360
window/size/window_height_override=900
window/size/min_width=360
window/size/min_height=480
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.82, 0.824, 0.788, 1)
